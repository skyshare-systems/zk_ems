generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(cuid())
  username     String         @unique
  password     String
  firstName    String
  lastName     String
  image        String
  role         Role           @default(ADMIN)
  isActivated  Boolean        @default(false)
  lastLogin    DateTime?
  lastLogout   DateTime?
  emailAddress String         @unique
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  tokens       Token[]
  transactions Transactions[]
  companies    UserCompany[]

  @@index([emailAddress])
  @@index([username])
}

model Company {
  id             String          @id @default(cuid())
  name           String          @unique
  image          String
  description    String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  Group          Group[]
  sentEmails     SentEmail[]
  smtpCredential SmtpCredential?
  storageConfig  StorageConfig?
  templates      Template[]
  users          UserCompany[]

  @@index([name])
}

model UserCompany {
  userId    String
  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, companyId])
  @@index([companyId])
  @@index([userId])
}

model Template {
  id          String      @id @default(cuid())
  description String
  name        String
  header      String
  footer      String
  tags        String[]
  companyId   String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  sentEmails  SentEmail[]
  company     Company     @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([name])
}

model SentEmail {
  id          String      @id @default(cuid())
  templateId  String
  companyId   String
  body        String
  footer      String
  header      String
  subject     String
  attachments String[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime
  recipients  Recipient[]
  company     Company     @relation(fields: [companyId], references: [id])
  template    Template    @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([templateId])
}

model Recipient {
  id             String           @id @default(cuid())
  sentEmailId    String
  emailAddress   String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  sentEmail      SentEmail        @relation(fields: [sentEmailId], references: [id], onDelete: Cascade)
  RecipientGroup RecipientGroup[]

  @@index([sentEmailId])
  @@index([emailAddress])
}

model Token {
  id          String    @id @default(cuid())
  token       String    @unique
  type        TokenType
  expires     DateTime
  blacklisted Boolean
  createdAt   DateTime  @default(now())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model SmtpCredential {
  id        String   @id @default(cuid())
  host      String
  port      Int
  username  String
  password  String
  from      String
  companyId String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model StorageConfig {
  id              String   @id @default(cuid())
  endpoint        String?
  region          String?
  bucketName      String?
  accessKeyId     String?
  secretAccessKey String?
  companyId       String   @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model Transactions {
  id        String   @id @default(cuid())
  action    Action
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Group {
  id             String           @id
  name           String
  tag            String
  tagColor       String
  description    String?
  companyId      String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  Company        Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  RecipientGroup RecipientGroup[]

  @@index([companyId])
  @@index([name])
  @@index([tag])
}

model RecipientGroup {
  recipientId String
  groupId     String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  Group       Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  Recipient   Recipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@id([recipientId, groupId])
  @@index([groupId])
  @@index([recipientId])
}

enum Role {
  USER
  ADMIN
}

enum TokenType {
  ACCESS
  REFRESH
  RESET_PASSWORD
  VERIFY_EMAIL
}

enum Action {
  SEND_EMAIL
  LOG_IN
  LOG_OUT
  UPDATE_CONFIG
}
