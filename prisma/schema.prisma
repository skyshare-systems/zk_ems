generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  emailAddress String        @unique
  username     String        @unique
  password     String
  firstName    String
  lastName     String
  image        String
  role         Role          @default(ADMIN) // ✅ Fixed enum default
  isActivated  Boolean       @default(false)
  lastLogin    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  tokens       Token[]
  companies    UserCompany[]
}

model Company {
  id             String          @id @default(cuid())
  name           String          @unique
  image          String
  description    String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  users          UserCompany[]
  templates      Template[]
  sentEmails     SentEmail[]
  smtpCredential SmtpCredential?
  storageConfig  StorageConfig?
}

model UserCompany {
  userId    String
  companyId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([userId, companyId])
}

model Template {
  id          String      @id @default(cuid())
  description String
  name        String
  subject     String
  header      String
  footer      String
  tags        String[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  companyId   String
  sentEmails  SentEmail[]
  company     Company     @relation(fields: [companyId], references: [id])
}

model SentEmail {
  id         String      @id @default(cuid())
  header     String
  body       String
  footer     String
  templateId String
  template   Template    @relation(fields: [templateId], references: [id], onDelete: Cascade)
  recipients Recipient[]
  companyId  String
  company    Company     @relation(fields: [companyId], references: [id])
  createdAt  DateTime    @default(now())
}

model Recipient {
  id           String    @id @default(cuid())
  emailAddress String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sentEmail    SentEmail @relation(fields: [sentEmailId], references: [id], onDelete: Cascade)
  sentEmailId  String
}

model Token {
  id          String    @id @default(cuid())
  token       String    @unique
  type        TokenType
  expires     DateTime
  blacklisted Boolean
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
}

model SmtpCredential {
  id        String   @id @default(cuid())
  host      String
  port      Int
  username  String
  password  String
  from      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String   @unique
}

model StorageConfig {
  id              String   @id @default(cuid())
  endpoint        String?
  region          String?
  bucketName      String?
  accessKeyId     String?
  secretAccessKey String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId       String   @unique
}

enum Role {
  USER
  ADMIN
}

enum TokenType {
  ACCESS
  REFRESH
  RESET_PASSWORD
  VERIFY_EMAIL
}
