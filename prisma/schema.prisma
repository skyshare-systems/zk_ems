generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(cuid())
  username     String         @unique
  password     String
  firstName    String
  lastName     String
  image        String
  role         Role           @default(ADMIN)
  isActivated  Boolean        @default(false)
  lastLogin    DateTime?
  lastLogout   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  emailAddress String         @unique
  tokens       Token[]
  transactions Transactions[]
  companies    UserCompany[]

  @@index([createdAt])
}

model Company {
  id                    String                 @id @default(cuid())
  name                  String                 @unique
  image                 String
  description           String
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  sentEmails            SentEmail[]
  smtpCredential        SmtpCredential?
  storageConfig         StorageConfig?
  templates             Template[]
  users                 UserCompany[]
  addressBookGroups     AddressBookGroup[]
  addressBookRecipients AddressBookRecipient[]

  @@index([createdAt])
}

model UserCompany {
  userId    String
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, companyId])
}

model Template {
  id          String      @id @default(cuid())
  description String
  name        String
  header      String
  footer      String
  tags        String[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  companyId   String
  sentEmails  SentEmail[]
  company     Company     @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([createdAt])
}

model SentEmail {
  id          String      @id @default(cuid())
  createdAt   DateTime    @default(now())
  templateId  String
  companyId   String
  body        String
  footer      String
  header      String
  subject     String
  attachments String[]
  recipients  Recipient[]
  company     Company     @relation(fields: [companyId], references: [id])
  template    Template    @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([templateId])
  @@index([createdAt])
}

model Recipient {
  id           String    @id @default(cuid())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sentEmailId  String
  emailAddress String
  photoUrl     String?
  sentEmail    SentEmail @relation(fields: [sentEmailId], references: [id], onDelete: Cascade)

  @@index([sentEmailId])
  @@index([emailAddress])
  @@index([createdAt])
}

model AddressBookRecipient {
  id           String             @id @default(cuid())
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  emailAddress String
  name         String
  photoUrl     String?
  companyId    String
  company      Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  groups       AddressBookGroup[] @relation("GroupMembers")

  @@index([companyId])
  @@index([emailAddress])
  @@index([name])
  @@index([createdAt])
}

model AddressBookGroup {
  id         String                 @id @default(cuid())
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt
  name       String
  tag        String
  color      String
  companyId  String
  company    Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  recipients AddressBookRecipient[] @relation("GroupMembers")

  @@index([companyId])
  @@index([name])
  @@index([createdAt])
}

model Token {
  id          String    @id @default(cuid())
  token       String    @unique
  type        TokenType
  expires     DateTime
  blacklisted Boolean
  createdAt   DateTime  @default(now())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model SmtpCredential {
  id        String   @id @default(cuid())
  host      String
  port      Int
  username  String
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  from      String
  companyId String   @unique
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model StorageConfig {
  id              String   @id @default(cuid())
  endpoint        String?
  region          String?
  bucketName      String?
  accessKeyId     String?
  secretAccessKey String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  companyId       String   @unique
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model Transactions {
  id        String   @id @default(cuid())
  action    Action
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model TestTable {
  id String @id @default(cuid())
  action String
}

enum Role {
  USER
  ADMIN
}

enum TokenType {
  ACCESS
  REFRESH
  RESET_PASSWORD
  VERIFY_EMAIL
}

enum Action {
  SEND_EMAIL
  LOG_IN
  LOG_OUT
  UPDATE_CONFIG
}

