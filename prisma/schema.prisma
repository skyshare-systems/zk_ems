generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String    @id @default(cuid())
  username    String    @unique
  password    String
  role        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  firstName   String
  lastName    String
  email       String    @unique
  isActivated Boolean   @default(false)
  lastLogin   DateTime?
  companies   Company[]
}

model Recipient {
  id           String     @id @default(cuid())
  email        String
  phone        String?
  company      String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  sentEmailsId String
  firstName    String
  lastName     String
  sentEmails   SentEmails @relation(fields: [sentEmailsId], references: [id])
}

model Company {
  id          String   @id @default(cuid())
  name        String   @unique
  image       String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String
  user        User     @relation(fields: [userId], references: [id])
}

model Template {
  id         String       @id @default(cuid())
  subject    String
  recipients String
  header     String
  body       String?
  footer     String
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  sentEmails SentEmails[]
}

model SentEmails {
  id         String      @id @default(cuid())
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  templateId String
  recipients Recipient[]
  template   Template    @relation(fields: [templateId], references: [id])
}
